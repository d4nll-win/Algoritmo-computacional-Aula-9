#include <stdio.h>

#define QTD 3

typedef struct
{
    int codigo;
    char nome[50];
    float preco;
} Produto;

int main()
{
    Produto produtos[QTD];
    Produto p;
    FILE *arq;
    int i;

    // a) Recebe os dados de 3 produtos e guarda em um vetor de struct
    for (i = 0; i < QTD; i++)
    {
        printf("--- Produto %d ---\n", i + 1);
        printf("Codigo: ");
        scanf("%d", &produtos[i].codigo);
        printf("Nome: ");
        scanf(" %49[^\n]", produtos[i].nome);
        printf("Preco: R$ ");
        scanf("%f", &produtos[i].preco);
    }

    // b) Salva em estoque.txt (um produto por linha, campos separados por ';')
    arq = fopen("estoque.txt", "w");
    if (arq == NULL)
    {
        printf("Erro ao criar o arquivo estoque.txt!\n");
        return 1;
    }
    for (i = 0; i < QTD; i++)
        fprintf(arq, "%d;%s;%.2f\n", produtos[i].codigo, produtos[i].nome, produtos[i].preco);
    fclose(arq);
    printf("\nDados salvos em estoque.txt\n");

    // c) Abre novamente para leitura e exibe com layout organizado
    arq = fopen("estoque.txt", "r");
    if (arq == NULL)
    {
        printf("Erro ao abrir o arquivo estoque.txt!\n");
        return 1;
    }

    printf("\n============== ESTOQUE ==============\n");
    printf("%-8s %-25s %10s\n", "Codigo", "Nome", "Preco (R$)");
    printf("-------------------------------------\n");
    while (fscanf(arq, " %d;%49[^;];%f", &p.codigo, p.nome, &p.preco) == 3)
        printf("%-8d %-25s %10.2f\n", p.codigo, p.nome, p.preco);
    printf("=====================================\n");

    fclose(arq);

    return 0;
}
