#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct
{
    int registro;
    int horas_aula;
} Professor;

// Le o arquivo inteiro com uma unica chamada fread e devolve um novo array dinamico
Professor *lerProfessores(const char *arquivo, int *qtd)
{
    FILE *arq;
    Professor *lista;
    long tamanho;

    *qtd = 0;
    arq = fopen(arquivo, "rb");
    if (arq == NULL)
        return NULL;

    // descobre quantos registros existem pelo tamanho do arquivo
    fseek(arq, 0, SEEK_END);
    tamanho = ftell(arq);
    rewind(arq);

    *qtd = (int) (tamanho / sizeof(Professor));
    if (*qtd == 0)
    {
        fclose(arq);
        return NULL;
    }

    lista = (Professor *) malloc(*qtd * sizeof(Professor));
    if (lista == NULL)
    {
        fclose(arq);
        *qtd = 0;
        return NULL;
    }

    fread(lista, sizeof(Professor), *qtd, arq);
    fclose(arq);

    return lista;
}

int main()
{
    int n, i, qtdLida;
    Professor *professores, *carregados;
    unsigned char *buffer;   // buffer bruto de bytes
    FILE *arq;

    do
    {
        printf("Quantos professores deseja cadastrar? ");
        scanf("%d", &n);
    } while (n < 1);

    // Array dinamico de N professores
    professores = (Professor *) malloc(n * sizeof(Professor));
    if (professores == NULL)
    {
        printf("Erro de memoria!\n");
        return 1;
    }

    for (i = 0; i < n; i++)
    {
        printf("--- Professor %d ---\n", i + 1);
        printf("Registro: ");
        scanf("%d", &professores[i].registro);
        printf("Horas-aula: ");
        scanf("%d", &professores[i].horas_aula);
    }

    // Buffer bruto de bytes com N * sizeof(Professor)
    buffer = (unsigned char *) malloc(n * sizeof(Professor));
    if (buffer == NULL)
    {
        printf("Erro de memoria!\n");
        free(professores);
        return 1;
    }

    // memcpy copia o array inteiro de structs para dentro do buffer
    memcpy(buffer, professores, n * sizeof(Professor));

    // Grava o buffer completo com UMA unica chamada de fwrite
    arq = fopen("folha.dat", "wb");
    if (arq == NULL)
    {
        printf("Erro ao criar folha.dat!\n");
        free(professores);
        free(buffer);
        return 1;
    }
    fwrite(buffer, sizeof(Professor), n, arq);
    fclose(arq);
    printf("\n%d professor(es) gravado(s) em folha.dat (%d bytes)\n", n, (int) (n * sizeof(Professor)));

    // Leitura: carrega tudo de volta em um novo array dinamico
    carregados = lerProfessores("folha.dat", &qtdLida);
    if (carregados == NULL)
    {
        printf("Erro ao ler folha.dat!\n");
    }
    else
    {
        printf("\n=== Professores lidos do arquivo ===\n");
        printf("%-10s %s\n", "Registro", "Horas-aula");
        for (i = 0; i < qtdLida; i++)
            printf("%-10d %d\n", carregados[i].registro, carregados[i].horas_aula);
        free(carregados);
    }

    free(professores);
    free(buffer);

    return 0;
}
